{
  "name": "beautycalendar-qa",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.cjs",
    "test:e2e": "playwright test --grep-invert @audit",
    "test:audit": "playwright test --grep @audit",
    "test:all": "playwright test",
    "test:visual": "playwright test --grep @baseline",
    "serve:test": "node tests/server.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.57.0"
  }
}
